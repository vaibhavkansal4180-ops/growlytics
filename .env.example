# ==============================================================================
# Growlytics – Environment Variables Template
# AI-Powered Retail Intelligence Platform
# ==============================================================================

# Flask Server Configuration
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=growlytics-super-secret-key-retail-intelligence-2026-prod

# Database Connection (PostgreSQL for Production, SQLite fallback for local testing)
# Supported services: Neon, Supabase, Vercel Postgres, AWS RDS
# Format: postgresql://username:password@host:5432/growlytics?sslmode=require
DATABASE_URL=

# Security & CORS Settings
CORS_ORIGINS=*
SESSION_COOKIE_SECURE=0

# AI Retail Copilot API (Optional)
# If provided, enables live LLM-driven business reasoning with injected retail context.
# If empty, Growlytics seamlessly falls back to its built-in rule-based Retail Intelligence engine.
OPENAI_API_KEY=
GEMINI_API_KEY=
